<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#071426" />
    <meta
      name="description"
      content="Corravale Digital builds production websites and web applications for startups and expanding businesses."
    />
    <title>Corravale Digital | Digital products, built properly.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <header class="nav" id="nav">
      <div class="container nav-inner">
        <a class="brand" href="#top" aria-label="Corravale Digital home">
          <span class="brand-mark">C</span>
          <span class="brand-text">
            <strong>Corravale</strong>
            <small>Digital</small>
          </span>
        </a>

        <nav class="nav-links" aria-label="Main navigation">
          <a href="#work">What We Build</a>
          <a href="#why">Why Corravale</a>
          <a href="#process">Process</a>
          <a href="#team">Team</a>
          <a href="#about">About</a>
        </nav>

        <div class="nav-actions">
          <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
            <span class="sun">☀</span>
            <span class="moon">☾</span>
          </button>
          <a class="nav-cta" href="#contact">Start a project</a>
          <button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false">
            <span class="hamb"><span></span><span></span></span>
          </button>
        </div>
      </div>
    </header>

    <div class="mobile-menu" id="mobileMenu">
      <a href="#work">What We Build</a>
      <a href="#why">Why Corravale</a>
      <a href="#process">Process</a>
      <a href="#team">Team</a>
      <a href="#about">About</a>
      <a class="contact-link" href="#contact">Start a project →</a>
    </div>

    <main id="top">
      <section class="hero" id="top">
        <div class="orb"></div>

        <div class="container hero-content">
          <div class="kicker reveal">
            <span class="dot"></span>
            <span class="eyebrow">Digital development studio · Founded 2026</span>
          </div>

          <h1 class="reveal delay1">
            Digital products<br />
            <span class="accent">built to grow.</span>
          </h1>

          <p class="hero-copy reveal delay2">
            We design and develop professional websites, web applications, and the systems behind them
            for startups and growing businesses. From the first idea to launch and beyond, we keep the
            people building your product close to you.
          </p>

          <div class="actions reveal delay3">
            <a class="btn primary" href="#contact">Start a project ↗</a>
            <a class="btn secondary" href="#work">Explore what we build ↓</a>
          </div>

          <div class="hero-meta reveal delay3">
            <div class="meta">
              <strong>01</strong>
              <span>Direct communication</span>
            </div>
            <div class="meta">
              <strong>02</strong>
              <span>Full-stack development</span>
            </div>
            <div class="meta">
              <strong>03</strong>
              <span>Built for growth</span>
            </div>
          </div>
        </div>
      </section>

      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          <span>Web Development <i>✦</i></span>
          <span>Frontend <i>✦</i></span>
          <span>Backend <i>✦</i></span>
          <span>Web Applications <i>✦</i></span>
          <span>Maintenance <i>✦</i></span>
          <span>Web Development <i>✦</i></span>
          <span>Frontend <i>✦</i></span>
          <span>Backend <i>✦</i></span>
          <span>Web Applications <i>✦</i></span>
          <span>Maintenance <i>✦</i></span>
        </div>
      </div>

      <section class="intro" id="about">
        <div class="container intro-layout">
          <div class="eyebrow reveal">01 / The studio</div>
          <div>
            <h2 class="reveal">Small team.<br /><span>Serious engineering.</span></h2>
            <p class="intro-copy reveal delay1">
              Corravale Digital is a small, close-knit development studio founded in 2026. We work with
              startups and expanding businesses that need more than a pretty website: they need digital
              products that can grow with them.
            </p>

            <div class="principles">
              <div class="principle reveal">
                <b>01</b>
                <strong>No account managers. No hand-offs.</strong>
              </div>
              <div class="principle reveal delay1">
                <b>02</b>
                <strong>The people who build it stay close to it.</strong>
              </div>
              <div class="principle reveal delay2">
                <b>03</b>
                <strong>One team from wireframe to deployment.</strong>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="capabilities" id="work">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow reveal">02 / What we build</div>
            <h2 class="reveal">Digital products<br />for real business needs.</h2>
          </div>

          <div class="capability-grid">
            <article class="capability reveal">
              <div class="capability-visual">
                <div class="browser">
                  <div class="browser-top"><span></span><span></span><span></span><div class="browser-url"></div></div>
                  <div class="browser-content">
                    <div class="site-nav"><div class="site-logo"></div><div class="site-links"><i></i><i></i><i></i></div></div>
                    <div class="demo-line large"></div>
                    <div class="demo-line"></div>
                    <div class="demo-line short"></div>
                    <div class="demo-button"></div>
                  </div>
                </div>
              </div>
              <div class="capability-content">
                <span class="capability-number">01</span>
                <h3>Business Websites</h3>
                <p>Professional, responsive websites that establish your brand, communicate your value and turn visitors into customers.</p>
                <span class="capability-link">Brand · Content · Conversion</span>
              </div>
            </article>

            <article class="capability reveal delay1">
              <div class="capability-visual">
                <div class="app-window">
                  <div class="app-sidebar"><span class="app-dot"></span><span class="app-dot"></span><span class="app-dot"></span></div>
                  <div class="app-main">
                    <div class="app-top"><div class="app-search"></div><div class="app-avatar"></div></div>
                    <div class="app-heading"></div>
                    <div class="app-cards"><span><i></i></span><span><i></i></span><span><i></i></span></div>
                    <svg class="app-chart" viewBox="0 0 200 60" preserveAspectRatio="none">
                      <path d="M0,45 L30,32 L60,38 L90,16 L120,26 L150,9 L180,20 L200,5"></path>
                    </svg>
                  </div>
                </div>
              </div>
              <div class="capability-content">
                <span class="capability-number">02</span>
                <h3>Web Applications</h3>
                <p>Custom applications built around your users, workflows and business requirements.</p>
                <span class="capability-link">Workflows · Features · Integrations</span>
              </div>
            </article>

            <article class="capability reveal">
              <div class="capability-visual">
                <div class="phone">
                  <div class="phone-notch"></div>
                  <div class="phone-screen">
                    <div class="phone-status"><i></i><i></i><i></i></div>
                    <div class="phone-title"></div>
                    <div class="phone-list">
                      <div class="phone-row"><span class="phone-avatar"></span><span class="phone-lines"><i></i><i></i></span></div>
                      <div class="phone-row"><span class="phone-avatar"></span><span class="phone-lines"><i></i><i></i></span></div>
                    </div>
                    <div class="phone-button"></div>
                    <div class="phone-tabbar"><i></i><i></i><i></i></div>
                  </div>
                </div>
              </div>
              <div class="capability-content">
                <span class="capability-number">03</span>
                <h3>Business Systems</h3>
                <p>Dashboards, management systems, booking platforms and portals that simplify day-to-day operations.</p>
                <span class="capability-link">Dashboards · Automation · Operations</span>
              </div>
            </article>

            <article class="capability reveal delay1">
              <div class="capability-visual">
                <div class="code-window">
                  <div class="code-top"></div>
                  <div class="code-body">
                    <div class="code-line"><span class="ln">1</span><i class="tok kw"></i><i class="tok fn"></i></div>
                    <div class="code-line"><span class="ln">2</span><i class="tok"></i><i class="tok str"></i><i class="tok"></i></div>
                    <div class="code-line"><span class="ln">3</span><i class="tok kw"></i><i class="tok"></i></div>
                    <div class="code-line"><span class="ln">4</span><i class="tok fn"></i><i class="tok str"></i><i class="tok"></i></div>
                    <div class="code-line"><span class="ln">5</span><i class="tok"></i></div>
                  </div>
                </div>
              </div>
              <div class="capability-content">
                <span class="capability-number">04</span>
                <h3>Backend &amp; APIs</h3>
                <p>The logic, databases, APIs and integrations that power the products behind the interface.</p>
                <span class="capability-link">Python · Flask · APIs</span>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="why" id="why">
        <div class="container why-grid">
          <div>
            <div class="eyebrow light reveal">03 / Why Corravale</div>
            <h2 class="reveal">A focused team.<br /><span>Clearer outcomes.</span></h2>
            <p class="why-copy reveal delay1">
              Corravale keeps development close to the people doing the work. That means fewer hand-offs,
              faster decisions and a clearer line from your business needs to the product we build.
            </p>
          </div>

          <div class="reason-list">
            <div class="reason reveal">
              <b>01</b>
              <strong>Direct communication</strong>
              <p>Work directly with the development team so questions, decisions and feedback stay close to the product.</p>
            </div>
            <div class="reason reveal delay1">
              <b>02</b>
              <strong>Purpose-built solutions</strong>
              <p>We build around the actual workflow, users and requirements of your business rather than forcing a generic solution.</p>
            </div>
            <div class="reason reveal delay2">
              <b>03</b>
              <strong>Built for the next stage</strong>
              <p>We consider maintainability, performance and future growth from the beginning, not as an afterthought.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="process" id="process">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow reveal">04 / How we work</div>
            <h2 class="reveal">From first sketch<br />to live product.</h2>
          </div>

          <div class="steps">
            <div class="step reveal">
              <div class="step-num">01</div>
              <div>
                <h3>Discover</h3>
                <p>Understand the business, users, constraints and what success actually means.</p>
              </div>
            </div>
            <div class="step reveal delay1">
              <div class="step-num">02</div>
              <div>
                <h3>Plan &amp; Design</h3>
                <p>Turn requirements into flows, wireframes and an interface with a clear purpose.</p>
              </div>
            </div>
            <div class="step reveal delay2">
              <div class="step-num">03</div>
              <div>
                <h3>Build</h3>
                <p>Develop the frontend, backend and integrations with quality and maintainability in mind.</p>
              </div>
            </div>
            <div class="step reveal delay3">
              <div class="step-num">04</div>
              <div>
                <h3>Launch &amp; Maintain</h3>
                <p>Test, deploy, monitor and keep improving the product after it goes live.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="team" id="team">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow reveal">05 / The team</div>
            <h2 class="reveal">The people<br />behind the build.</h2>
          </div>

          <div class="team-grid">
            <article class="member founder reveal">
              <span class="initial">D</span>
              <strong>Dominion</strong>
              <span>Team Lead</span>
            </article>
            <article class="member reveal delay1">
              <span class="initial">M</span>
              <strong>Maxwell</strong>
              <span>Development Team</span>
            </article>
            <article class="member reveal delay2">
              <span class="initial">M</span>
              <strong>Micah</strong>
              <span>Development Team</span>
            </article>
            <article class="member reveal">
              <span class="initial">I</span>
              <strong>Israel</strong>
              <span>Development Team</span>
            </article>
            <article class="member reveal delay1">
              <span class="initial">N</span>
              <strong>Nanpyal</strong>
              <span>Development Team</span>
            </article>
            <article class="member reveal delay2">
              <span class="initial">J</span>
              <strong>Joseph</strong>
              <span>Development Team</span>
            </article>
            <article class="member reveal delay3">
              <span class="initial">J</span>
              <strong>Julius</strong>
              <span>Development Team</span>
            </article>
          </div>
        </div>
      </section>

      <section class="faq">
        <div class="container">
          <div class="section-head">
            <div class="eyebrow reveal">06 / FAQ</div>
            <h2 class="reveal">A few things<br />worth knowing.</h2>
          </div>

          <div class="faq-list">
            <div class="faq-item reveal">
              <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-1">
                Who will I actually work with?
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-answer" id="faq-answer-1">
                <p>You work directly with the small Corravale development team. We keep communication close and avoid unnecessary hand-offs.</p>
              </div>
            </div>

            <div class="faq-item reveal delay1">
              <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-2">
                Do you only build websites?
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-answer" id="faq-answer-2">
                <p>No. Websites are one part of what we do. We also build responsive interfaces, web applications, backend systems and APIs.</p>
              </div>
            </div>

            <div class="faq-item reveal delay2">
              <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-3">
                Can you maintain a website after launch?
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-answer" id="faq-answer-3">
                <p>Yes. Maintenance, updates, fixes and performance checks can continue after launch so the product does not become a forgotten artifact.</p>
              </div>
            </div>

            <div class="faq-item reveal delay3">
              <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-4">
                Do you work with startups?
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-answer" id="faq-answer-4">
                <p>Yes. Corravale is specifically positioned to help startups and expanding businesses turn ideas into useful, production-ready digital products.</p>
              </div>
            </div>

            <div class="faq-item reveal">
              <button class="faq-question" aria-expanded="false" aria-controls="faq-answer-5">
                How much does a project cost?
                <span class="faq-icon">+</span>
              </button>
              <div class="faq-answer" id="faq-answer-5">
                <p>Every project is different. Pricing depends on the scope, features, complexity, timeline and long-term support needed.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="contact" id="contact">
        <div class="container">
          <div class="contact-box reveal">
            <div class="eyebrow">07 / Start a project</div>
            <h2>Have something<br />worth building?</h2>
            <p class="contact-copy">
              Tell us what you need, what you're trying to achieve and where you are in the process. We'll
              review the brief and discuss the right way to build it.
            </p>

            <form id="contactForm" novalidate style="display: flex; flex-direction: column; gap: 12px; max-width: 560px; margin-bottom: 24px;">
              <input 
                type="email" 
                id="contactEmail" 
                placeholder="Your email address" 
                required 
                style="width: 100%; padding: 14px 18px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-family: inherit;"
              />
              <textarea 
                id="contactMessage" 
                placeholder="Tell us about your project..." 
                required 
                rows="4" 
                style="width: 100%; padding: 14px 18px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-family: inherit; resize: vertical;"
              ></textarea>
              <!-- Invisible Spam Trap (Honeypot) -->
              <input type="text" id="website_hp" name="website_hp" style="display:none !important;" tabindex="-1" autocomplete="off" />
              <button type="submit" id="submitBtn" class="btn primary" style="cursor: pointer; align-self: flex-start;">
                Start the conversation ↗
              </button>
            </form>

            <div class="contact-details">
              <a class="contact-pill" href="#" aria-label="Corravale Digital on X">X · @CorravaleDum</a>
              <a class="contact-pill" href="#" aria-label="Corravale Digital on Instagram">Instagram · digitalcorravale</a>
              <a class="contact-pill" href="#" aria-label="Corravale Digital on TikTok">TikTok · @corravale.digital</a>
              <a class="contact-pill" href="#" aria-label="Corravale Digital on Facebook">Facebook · Corravale</a>
              <a class="contact-pill" href="#" aria-label="Corravale Digital on YouTube">YouTube · @Corraval.digitals</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="footer-brand">CORRAVALE DIGITAL</div>
            <p class="footer-copy">Production websites and web applications for growing businesses.</p>
          </div>

          <div class="footer-links">
            <a href="#work">What We Build</a>
            <a href="#why">Why Corravale</a>
            <a href="#team">Team</a>
            <a href="#contact">Contact</a>
          </div>
        </div>

        <div class="footer-bottom">
          <span>© 2026 Corravale Digital. All rights reserved.</span>
          <span>Built to move businesses forward.</span>
        </div>
      </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <div id="toastContainer" aria-live="polite" aria-atomic="true"></div>
    <script src="app.js" defer></script>
  </body>
</html>